# Backend environment variables
# Copy to backend/.env (never commit .env)

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL (Neon in production / shared hosting)
# DATABASE_URL: pooled connection for application runtime (Neon pooler host when available)
# DIRECT_URL: direct/non-pooled connection for Prisma migrations
#
# Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Local development example (same URL for both when not using a pooler):
# DATABASE_URL=postgresql://calorie:calorie@localhost:5433/calorie_tracker
# DIRECT_URL=postgresql://calorie:calorie@localhost:5433/calorie_tracker
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Reserved for Phase 1+ (not used in Phase 0)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# AI_API_KEY=
# AI_API_BASE_URL=
