# Backend environment variables
# Copy to backend/.env (never commit .env)

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL (Neon in production / shared hosting)
# DATABASE_URL: pooled connection for application runtime (Neon pooler host when available)
# DIRECT_URL: direct/non-pooled connection for Prisma migrations
#
# Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Frontend origin(s) allowed by CORS (comma-separated). Do not use *.
# Development default is the Vite origin. Add production origins in deployed environments.
CORS_ORIGIN=http://localhost:5173

# Auth (Phase 1) — use long random secrets (>= 32 chars)
# JWT_REFRESH_SECRET is also used as a pepper when hashing refresh tokens at rest.
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_TIME_WINDOW_MS=60000

# AI nutrition extraction and conversational AI (Gemini). Never expose this key to the frontend.
# AI_RATE_LIMIT_MAX applies to both /ai/nutrition-extract and /ai/chat (including confirm-meal).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_UPLOAD_BYTES=5242880
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_TIME_WINDOW_MS=60000
AI_PROVIDER_TIMEOUT_MS=25000

# PDF food diary import. Preview is rate-limited separately from auth.
PDF_MAX_UPLOAD_BYTES=5242880
PDF_RATE_LIMIT_MAX=10
PDF_RATE_LIMIT_TIME_WINDOW_MS=60000

# Barcode lookup uses Open Food Facts (no API key). Rate limit and timeout reuse the AI values above.
