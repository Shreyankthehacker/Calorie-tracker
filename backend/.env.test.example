# Copy to backend/.env.test for local/CI backend tests.
# Tests must NOT use the Neon development database.

NODE_ENV=test
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Isolated local Postgres (example — Docker on port 5434)
DATABASE_URL=postgresql://calorie_test:calorie_test@localhost:5434/calorie_tracker_test
DIRECT_URL=postgresql://calorie_test:calorie_test@localhost:5434/calorie_tracker_test

JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_TIME_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=1000
AI_RATE_LIMIT_TIME_WINDOW_MS=60000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PDF_MAX_UPLOAD_BYTES=5242880
PDF_RATE_LIMIT_MAX=1000
PDF_RATE_LIMIT_TIME_WINDOW_MS=60000
